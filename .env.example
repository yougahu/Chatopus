# Private: copy to .env, chmod 600 .env. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Independent Router and Worker keys. The two values may be different providers/accounts.
ROUTER_API_KEY=
WORKER_API_KEY=
# Used for OpenViking identity provisioning and administrative model configuration.
# Content requests use generated group USER keys, never this root key.
OPENVIKING_ROOT_API_KEY=
# Needed only when explicitly enabling QQ.
QQ_SELF_ID=
ONEBOT_ACCESS_TOKEN=
# Optional custom provider declared in config.local.json.
DEEPSEEK_API_KEY=
# Optional trusted QQ bridge image-cache directory on this host.
# Separate from this application's automatic .runtime/incoming-images cache.
QQ_IMAGE_CACHE_ROOT=
